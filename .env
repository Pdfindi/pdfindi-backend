# Cloudmersive API Key (for PDF conversion features)
CLOUDMERSIVE_API_KEY=your_api_key_here

# Email Configuration (for contact form)
# Hostinger Email Settings
# Use your Hostinger email password (the one you use to login to webmail)
# Webmail: https://webmail.hostinger.com

EMAIL_HOST=smtp.hostinger.com
EMAIL_PORT=465
EMAIL_USER=support@pdfindi.com
EMAIL_PASSWORD=your_hostinger_email_password_here

# Port
PORT=3000